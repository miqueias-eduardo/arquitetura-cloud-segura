                <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;spacing=10;arcSize=3;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;Fluxos&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Seta preta&lt;/b&gt; = fluxo permitido&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;Seta cinza &lt;/b&gt;= saída para atualizações (NAT)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Seta&lt;/b&gt; &lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;cinza tracejada&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt; = role do IAM&lt;/span&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;Seta vermelha tracejada = fluxo bloqueado&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;① a&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: center; white-space: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;⑨&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;= número do fluxo na tabela de fluxos&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">

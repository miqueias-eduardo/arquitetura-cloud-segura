                <mxCell id="rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=12;spacing=10;arcSize=3;" value="&lt;div&gt;&lt;b style=&quot;color: rgb(0, 0, 0);&quot;&gt;Regras de segurança (Security Groups)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;SG-ALB:&lt;/b&gt; entrada 443 da internet · saída 8080 → SG-APP&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;SG-APP:&lt;/b&gt; entrada 8080 do SG-ALB e 22 do SG-VPN · saída 5432 → SG-DB,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;443 → endpoint e 443 → internet (via NAT)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;SG-DB&lt;/b&gt;: entrada 5432 só do SG-APP · sem saída para a internet&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;SG-VPN:&lt;/b&gt; saída 22 → SG-APP&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;Sub-redes de aplicação:&lt;/b&gt; saída para a internet só pelo NAT&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;Sub-redes de dados:&lt;/b&gt; sem rota para a internet&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;S3: &lt;/b&gt;Block Public Access · acesso só pelo endpoint&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;IAM:&lt;/b&gt; role da EC2 com menor privilégio · administradores com MFA&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;CloudTrail:&lt;/b&gt; registra as chamadas de API da conta&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="361" width="340" x="1320" y="25" as="geometry"/>
                </mxCell>
                <mxCell id="cidr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;spacing=10;arcSize=3;" value="&lt;b&gt;Faixas de IP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Públicas:&lt;/b&gt; 10.0.1.0/24 e 10.0.2.0/24&lt;br&gt;&lt;b&gt;App:&lt;/b&gt; 10.0.11.0/24 e 10.0.12.0/24&lt;br&gt;&lt;b&gt;Dados:&lt;/b&gt; 10.0.21.0/24 e 10.0.22.0/24" vertex="1">
